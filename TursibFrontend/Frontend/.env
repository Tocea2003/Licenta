# API Backend URL
# Pentru development local (PC)
VITE_API_URL=http://localhost:5022/api

# Pentru acces de pe telefon, înlocuiește localhost cu IP-ul PC-ului
# Exemplu: VITE_API_URL=http://192.168.1.100:5022/api

# Firebase Configuration
# Pentru Firebase Realtime Database în mod test (fără autentificare completă)
VITE_FIREBASE_DATABASE_URL=https://licenta-ulbs-default-rtdb.europe-west1.firebasedatabase.app

# Google OAuth 2.0 Client ID
# Obține un client ID de la Google Cloud Console: https://console.cloud.google.com/
# Creează un proiect → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URIs: http://localhost:5173
